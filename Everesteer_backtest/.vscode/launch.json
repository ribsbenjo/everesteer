{
  // F5 / Run and Debug panel. All runs use the integrated terminal so round.py can ask questions.
  // "subProcess": false keeps the debugger out of the per-round worker processes (much faster).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Round: points -> backtest -> submit",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/round.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "Round (stress test)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/round.py",
      "args": ["--stress"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": false,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "Status: live breakdown + calibration",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/round.py",
      "args": ["--status"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "Recheck past rounds with current tester",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/round.py",
      "args": ["--recheck"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": false,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "Backtest only (no submit, fast in-process)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backtest.py",
      "args": ["--label", "${input:label}", "--inprocess"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "Replay a real round",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backtest.py",
      "args": ["--replay", "${input:roundDate}", "--replay-file", "${input:submissionFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ],
  "inputs": [
    { "id": "label", "type": "promptString", "description": "What changed?", "default": "experiment" },
    { "id": "roundDate", "type": "promptString", "description": "Round date (YYYY-MM-DD)" },
    { "id": "submissionFile", "type": "promptString", "description": "Submission file we sent", "default": "submission.csv" }
  ]
}
